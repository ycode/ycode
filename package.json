{
  "name": "ycode",
  "version": "1.30.12",
  "description": "Visual website builder you can self-host",
  "license": "MIT",
  "private": false,
  "author": "Ycode",
  "homepage": "https://www.ycode.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ycode/ycode.git"
  },
  "keywords": [
    "website-builder",
    "visual-editor",
    "no-code",
    "self-hosted",
    "nextjs",
    "supabase"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "next dev -p 3002",
    "dev:webpack": "next dev -p 3002 --webpack",
    "prod": "npm run build && npm run start",
    "build": "next build",
    "start": "next start -p 3002",
    "cache:clear": "rm -rf .next",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit",
    "test": "TS_NODE_TRANSPILE_ONLY=1 TS_NODE_PROJECT=tsconfig.test.json node --test --require ts-node/register --require tsconfig-paths/register lib/layer-style-resolve.test.ts lib/import/adapters/webflow/global-styles.test.ts lib/current-page-filter.test.ts lib/apps/airtable/markdown-to-tiptap.test.ts lib/agent/tools/to-anthropic.test.ts lib/agent/tools/compact-result.test.ts lib/agent/tools/deferred.test.ts lib/page-head-path.test.ts lib/parse-head-html.test.ts",
    "migrate:make": "NODE_NO_WARNINGS=1 knex migrate:make --knexfile knexfile.ts -x ts",
    "migrate:latest": "NODE_NO_WARNINGS=1 knex migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "NODE_NO_WARNINGS=1 knex migrate:rollback --knexfile knexfile.ts",
    "migrate:status": "NODE_NO_WARNINGS=1 knex migrate:status --knexfile knexfile.ts",
    "migrate:credentials": "npx ts-node scripts/migrate-credentials.ts",
    "agent:tools": "TS_NODE_TRANSPILE_ONLY=1 TS_NODE_PROJECT=tsconfig.test.json node --require ts-node/register --require tsconfig-paths/register scripts/list-agent-tools.ts",
    "agent:smoke": "TS_NODE_TRANSPILE_ONLY=1 TS_NODE_PROJECT=tsconfig.test.json node --require ts-node/register --require tsconfig-paths/register scripts/smoke-agent.ts",
    "fonts:update": "npx ts-node scripts/fetch-google-fonts.ts",
    "prepare": "husky"
  },
  "dependencies": {
